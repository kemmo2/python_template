#!/usr/bin/env bash

set -euo pipefail

PROJECT_SLUG="{{ project_slug }}"

echo "Project: ${PROJECT_SLUG}"
echo

# -----------------------------------------------------------------------------
# 必要なコマンドの確認
# -----------------------------------------------------------------------------

if ! command -v uv >/dev/null 2>&1; then
    echo "Error: uv が見つかりません。"
    echo "macOSでは次を実行してください:"
    echo "  brew install uv"
    exit 1
fi

if ! command -v git >/dev/null 2>&1; then
    echo "Error: git が見つかりません。"
    exit 1
fi

if [ ! -f "pyproject.toml" ]; then
    echo "Error: pyproject.toml が見つかりません。"
    echo "生成されたプロジェクトのルートで実行してください。"
    exit 1
fi

# -----------------------------------------------------------------------------
# Python環境の構築
# -----------------------------------------------------------------------------

echo "Installing dependencies..."
uv sync
echo

# -----------------------------------------------------------------------------
# Gitリポジトリの初期化
# -----------------------------------------------------------------------------

if [ ! -d ".git" ]; then
    echo "Initializing Git repository..."
    git init -b main
else
    echo "Git repository already initialized."

    CURRENT_BRANCH="$(git branch --show-current)"

    if [ "$CURRENT_BRANCH" = "master" ]; then
        echo "Renaming branch from master to main..."
        git branch -m main
    fi
fi

echo

# -----------------------------------------------------------------------------
# pre-commitの登録
# -----------------------------------------------------------------------------

echo "Installing pre-commit hook..."
uv run pre-commit install
echo

# -----------------------------------------------------------------------------
# Ruffによる自動修正・整形
# -----------------------------------------------------------------------------

echo "Fixing lint issues with Ruff..."
uv run ruff check --fix .
echo

echo "Formatting files with Ruff..."
uv run ruff format .
echo

# -----------------------------------------------------------------------------
# 全品質チェック
# -----------------------------------------------------------------------------

echo "Running quality checks..."
uv run pre-commit run --all-files
echo

# -----------------------------------------------------------------------------
# 初回commit
# -----------------------------------------------------------------------------

echo "Staging generated files..."
git add .

if git diff --cached --quiet; then
    echo "No changes to commit."
else
    echo "Creating initial commit..."

    if ! git commit -m "Initial commit"; then
        echo
        echo "Error: Initial commit failed."
        echo "修正されたファイルを確認し、次を再実行してください:"
        echo "  git add ."
        echo "  git commit -m \"Initial commit\""
        exit 1
    fi
fi

echo

# -----------------------------------------------------------------------------
# GitHubリポジトリ作成
# -----------------------------------------------------------------------------

read -r -p \
    "Create private GitHub repository '${PROJECT_SLUG}' and push? [y/N] " \
    ans

case "$ans" in
    [Yy]|[Yy][Ee][Ss])
        if ! command -v gh >/dev/null 2>&1; then
            echo
            echo "Error: GitHub CLI が見つかりません。"
            echo "macOSでは次を実行してください:"
            echo "  brew install gh"
            exit 1
        fi

        if ! gh auth status >/dev/null 2>&1; then
            echo
            echo "Error: GitHub CLIにログインしていません。"
            echo "次を実行してください:"
            echo "  gh auth login"
            exit 1
        fi

        if git remote get-url origin >/dev/null 2>&1; then
            echo
            echo "Error: origin リモートはすでに設定されています。"
            echo "現在のorigin:"
            git remote get-url origin
            exit 1
        fi

        echo
        echo "Creating private GitHub repository '${PROJECT_SLUG}'..."

        gh repo create "$PROJECT_SLUG" \
            --private \
            --source=. \
            --remote=origin \
            --push

        echo
        echo "GitHub repository created and pushed."
        ;;

    *)
        echo
        echo "GitHub repository creation skipped."
        echo
        echo "後から作成する場合は、次を実行してください:"
        echo "  gh repo create \"${PROJECT_SLUG}\" \\"
        echo "      --private \\"
        echo "      --source=. \\"
        echo "      --remote=origin \\"
        echo "      --push"
        ;;
esac

echo
echo "Setup completed."